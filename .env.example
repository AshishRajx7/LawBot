# LawBot Environment Configuration

# -----------------------------------------------------------------------------
# LLM Provider Options (Configure at least ONE provider):
# -----------------------------------------------------------------------------

# 1. Groq (Recommended - 100% Free, Sub-second inference, 14,400 daily requests)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Hugging Face Inference API (Requires pre-paid credits or PRO subscription)
# Get token at: https://huggingface.co/settings/tokens
HF_API_KEY=hf_your_huggingface_api_token_here

# 3. OpenRouter (Free and pay-as-you-go models)
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here

# 4. Google Gemini (Google AI Studio free tier)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override default provider ("groq", "huggingface", "openrouter", "gemini", "custom")
# LLM_PROVIDER=groq

# -----------------------------------------------------------------------------
# Optional Custom / OpenAI-compatible Endpoint:
# -----------------------------------------------------------------------------
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Local Reranker Model:
# -----------------------------------------------------------------------------
RERANK_MODEL=ms-marco-TinyBERT-L-2-v2
